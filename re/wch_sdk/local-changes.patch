diff --git a/EVT/EXAM/SRC/RVMSIS/core_riscv.h b/EVT/EXAM/SRC/RVMSIS/core_riscv.h
index a5b14d1..ee269b0 100644
--- a/EVT/EXAM/SRC/RVMSIS/core_riscv.h
+++ b/EVT/EXAM/SRC/RVMSIS/core_riscv.h
@@ -642,8 +642,9 @@ __attribute__((always_inline)) RV_STATIC_INLINE uint32_t __get_SP(void)
  */
 __attribute__((always_inline)) RV_STATIC_INLINE void __MCPY(void *dst, void *start, void *end)
 {
-    __asm volatile("mcpy %2, %0, %1" : \
-                   "+r"(start), "+r"(dst) : "r"(end) : "memory");
+    /* xPack GCC has no WCH `mcpy` instruction. */
+    { uint8_t *d = (uint8_t *)dst; uint8_t *s = (uint8_t *)start;
+      while (s < (uint8_t *)end) *d++ = *s++; }
 }
 
 #define SysTick_SR_SWIE             (1 << 31)
